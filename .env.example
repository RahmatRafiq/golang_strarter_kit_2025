APP_NAME="Golang Starter Kit 2025"
APP_ENV=development
APP_SCHEME=http
APP_HOST=localhost
APP_PORT=8080
APP_VERSION=1.0.0
APP_DESCRIPTION="Merupakan aplikasi yang dibangun dengan bahasa pemrograman Go, menggunakan framework Gin dan Gorm, serta database MySQL dan MongoDB. Aplikasi ini dirancang untuk memberikan kemudahan dalam pengelolaan data dan menyediakan API yang efisien untuk kebutuhan pengembangan aplikasi."

# Default Database Configuration
DB_CONNECTION=mysql

# MySQL Primary Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=golang_starter_kit_2025
DB_USERNAME=root
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_TIMEZONE=Local
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=200
DB_CONN_MAX_LIFETIME=15
DB_CONN_MAX_IDLE_TIME=5

# MySQL Legacy (for backward compatibility)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=golang_starter_kit_2025
MYSQL_USER=user
MYSQL_PASSWORD=password

# MySQL Secondary Database
MYSQL_SECONDARY_HOST=localhost
MYSQL_SECONDARY_PORT=3306
MYSQL_SECONDARY_DB=secondary_db
MYSQL_SECONDARY_USER=root
MYSQL_SECONDARY_PASSWORD=secret
MYSQL_SECONDARY_CHARSET=utf8mb4
MYSQL_SECONDARY_COLLATION=utf8mb4_unicode_ci
MYSQL_SECONDARY_PREFIX=
MYSQL_SECONDARY_TIMEZONE=Local
MYSQL_SECONDARY_MAX_IDLE_CONNS=10
MYSQL_SECONDARY_MAX_OPEN_CONNS=200
MYSQL_SECONDARY_CONN_MAX_LIFETIME=15
MYSQL_SECONDARY_CONN_MAX_IDLE_TIME=5

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_CHARSET=utf8
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_MAX_OPEN_CONNS=200
POSTGRES_CONN_MAX_LIFETIME=15
POSTGRES_CONN_MAX_IDLE_TIME=5

# SQLite Database
SQLITE_DATABASE=database/database.sqlite
SQLITE_MAX_IDLE_CONNS=1
SQLITE_MAX_OPEN_CONNS=1
SQLITE_CONN_MAX_LIFETIME=15
SQLITE_CONN_MAX_IDLE_TIME=5

# SQL Server Database
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=sqlserver_db
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourPassword123!
SQLSERVER_MAX_IDLE_CONNS=10
SQLSERVER_MAX_OPEN_CONNS=200
SQLSERVER_CONN_MAX_LIFETIME=15
SQLSERVER_CONN_MAX_IDLE_TIME=5

# MongoDB Database
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=mongo_db
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_AUTH_MECHANISM=
MONGO_REPLICA_SET=
MONGO_READ_PREFERENCE=primary
MONGO_WRITE_CONCERN=majority
MONGO_READ_CONCERN=local
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_CONN_IDLE_TIME=0
MONGO_SERVER_SELECTION_TIMEOUT=30
# MONGO_COLL="${APP_ENV}"

DB_FORWARDER_PORT=3307

JWT_EXPIRE_MINUTES=60
IMAGE_EXPIRE_MINUTES=2