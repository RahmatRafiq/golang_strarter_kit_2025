# ============================================
# Application Configuration
# ============================================
APP_NAME="Golang Starter Kit 2025"
APP_ENV=development
APP_SCHEME=http
APP_HOST=localhost
APP_PORT=9999
APP_VERSION=1.0.0
APP_DESCRIPTION="Multi-Database Golang Starter Kit dengan dukungan MySQL/MariaDB dan PostgreSQL"

# Logging Configuration
# Options: debug | info | warn | error | fatal
LOG_LEVEL=info

# ============================================
# Security Configuration
# ============================================

# JWT Secret Key - REQUIRED
# Generate using: openssl rand -base64 48
# WARNING: NEVER use placeholder in production!
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=60

# Development Authentication Bypass
# Set to 'true' to skip JWT authentication (development only)
# WARNING: NEVER set to 'true' in production!
SKIP_AUTH=true

# Rate Limiting Configuration
# Global rate limit (per IP): Prevent DDoS attacks
RATE_LIMIT_GLOBAL=100
# Auth rate limit (per IP): Prevent brute force on login/register
RATE_LIMIT_AUTH=5
RATE_LIMIT_AUTH_PERIOD_MINUTES=15
# User rate limit (per authenticated user): Prevent API abuse
RATE_LIMIT_USER=1000
RATE_LIMIT_USER_PERIOD_MINUTES=60

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Default Database Connection
# ============================================
# Options: mysql | postgres | mysql_secondary
# This is used when --connection flag is NOT specified
# Example: go run main.go migrate:all  <- uses this connection
DB_CONNECTION=mysql

# ============================================
# MySQL Configuration (Primary)
# ============================================
# This connection is used when: --connection=mysql
# Or when DB_CONNECTION=mysql and no flag specified
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=golang_starter_kit_2025
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEZONE=Local

# Connection Pool Settings
MYSQL_MAX_IDLE_CONNS=10
MYSQL_MAX_OPEN_CONNS=200
MYSQL_CONN_MAX_LIFETIME=15m
MYSQL_CONN_MAX_IDLE_TIME=5m

# ============================================
# PostgreSQL Configuration
# ============================================
# This connection is used when: --connection=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=golang_starter_kit_2025_pg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC

# Connection Pool Settings
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_MAX_OPEN_CONNS=200
POSTGRES_CONN_MAX_LIFETIME=15m
POSTGRES_CONN_MAX_IDLE_TIME=5m

# ============================================
# MySQL Secondary Configuration (Optional)
# ============================================
# This connection is used when: --connection=mysql_secondary
# Useful for: multi-tenant, multi-region, or microservices
MYSQL_SECONDARY_HOST=localhost
MYSQL_SECONDARY_PORT=3307
MYSQL_SECONDARY_DB=golang_starter_kit_2025_secondary
MYSQL_SECONDARY_USER=root
MYSQL_SECONDARY_PASSWORD=your_mysql_password
MYSQL_SECONDARY_CHARSET=utf8mb4
MYSQL_SECONDARY_TIMEZONE=Local

# Connection Pool Settings
MYSQL_SECONDARY_MAX_IDLE_CONNS=10
MYSQL_SECONDARY_MAX_OPEN_CONNS=200
MYSQL_SECONDARY_CONN_MAX_LIFETIME=15m
MYSQL_SECONDARY_CONN_MAX_IDLE_TIME=5m

# ============================================
# MongoDB Configuration (Optional)
# ============================================
# Uncomment if using MongoDB
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB=golang_starter_kit_2025
# MONGO_USER=root
# MONGO_PASS=your_mongo_password
# MONGO_COLL="${APP_ENV}"

# ============================================
# Other Configuration
# ============================================
IMAGE_EXPIRE_MINUTES=2
DB_FORWARDER_PORT=3307


# ============================================
# Redis Configuration (Performance & Caching)
# ============================================
# Redis is used for:
# 1. Service-layer caching (User, Role, Permission queries)
# 2. HTTP response caching (GET requests)
# 3. Job queue backend (Asynq)
#
# Performance improvement with caching: 90-95% response time reduction
# Optional but HIGHLY RECOMMENDED for production
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379

# Cache TTL Configuration
# Short: 5 min, Medium: 30 min, Long: 2 hours, Day: 24 hours
# See documentation/CACHING.md for details
CACHE_DEFAULT_TTL=1800  # Default: 30 minutes (in seconds)

# Health Check History Configuration (uses Redis)
# How often to collect health check data (in minutes)
HEALTH_CHECK_INTERVAL=5
# How many days to keep historical data
HEALTH_HISTORY_RETENTION_DAYS=90

# ============================================
# Job Queue Configuration (Async Processing)
# ============================================
# Enable/disable job queue system
QUEUE_ENABLED=true

# Queue Redis connection (can be same as cache or separate)
QUEUE_REDIS_ADDR=localhost:6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1

# Worker concurrency (number of workers processing jobs simultaneously)
QUEUE_CONCURRENCY=10

# ============================================
# Email/SMTP Configuration
# ============================================
# SMTP server settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email sender information
SMTP_FROM_ADDRESS=noreply@yourapp.com
SMTP_FROM_NAME=Your App Name

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the app password (not your regular password)

# For other providers:
# - SendGrid: smtp.sendgrid.net:587
# - Mailgun: smtp.mailgun.org:587
# - Amazon SES: email-smtp.us-east-1.amazonaws.com:587

# ============================================
# Password Reset Configuration
# ============================================
# URL for password reset links (used in emails)
APP_URL=http://localhost:3000

# Password reset token expiry time in hours
PASSWORD_RESET_EXPIRY_HOURS=1

# Email verification token expiry time in hours
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# ============================================
# Performance Configuration
# ============================================
# Request timeout in seconds (prevents long-running requests)
REQUEST_TIMEOUT_SECONDS=30

# Cache TTL in minutes
CACHE_TTL_MINUTES=5

# ============================================
# OAuth2 Configuration (Social Login)
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# S3/MinIO Storage Configuration
# ============================================
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_BUCKET=uploads
S3_REGION=us-east-1

# ============================================
# Distributed Tracing (OpenTelemetry)
# ============================================
TRACING_ENABLED=false
JAEGER_URL=http://localhost:14268/api/traces