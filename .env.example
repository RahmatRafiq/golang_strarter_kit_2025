# ============================================
# Application Configuration
# ============================================
APP_NAME="Golang Starter Kit 2025"
APP_ENV=development
APP_SCHEME=http
APP_HOST=localhost
APP_PORT=9999
APP_VERSION=1.0.0
APP_DESCRIPTION="Multi-Database Golang Starter Kit dengan dukungan MySQL/MariaDB dan PostgreSQL"

# Logging Configuration
# Options: debug | info | warn | error | fatal
LOG_LEVEL=info

# ============================================
# Security Configuration
# ============================================

# JWT Secret Key - REQUIRED
# Generate using: openssl rand -base64 48
# WARNING: NEVER use placeholder in production!
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=60

# Development Authentication Bypass
# Set to 'true' to skip JWT authentication (development only)
# WARNING: NEVER set to 'true' in production!
SKIP_AUTH=true

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Default Database Connection
# ============================================
# Options: mysql | postgres | mysql_secondary
# This is used when --connection flag is NOT specified
# Example: go run main.go migrate:all  <- uses this connection
DB_CONNECTION=mysql

# ============================================
# MySQL Configuration (Primary)
# ============================================
# This connection is used when: --connection=mysql
# Or when DB_CONNECTION=mysql and no flag specified
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=golang_starter_kit_2025
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEZONE=Local

# Connection Pool Settings
MYSQL_MAX_IDLE_CONNS=10
MYSQL_MAX_OPEN_CONNS=200
MYSQL_CONN_MAX_LIFETIME=15m
MYSQL_CONN_MAX_IDLE_TIME=5m

# ============================================
# PostgreSQL Configuration
# ============================================
# This connection is used when: --connection=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=golang_starter_kit_2025_pg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC

# Connection Pool Settings
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_MAX_OPEN_CONNS=200
POSTGRES_CONN_MAX_LIFETIME=15m
POSTGRES_CONN_MAX_IDLE_TIME=5m

# ============================================
# MySQL Secondary Configuration (Optional)
# ============================================
# This connection is used when: --connection=mysql_secondary
# Useful for: multi-tenant, multi-region, or microservices
MYSQL_SECONDARY_HOST=localhost
MYSQL_SECONDARY_PORT=3307
MYSQL_SECONDARY_DB=golang_starter_kit_2025_secondary
MYSQL_SECONDARY_USER=root
MYSQL_SECONDARY_PASSWORD=your_mysql_password
MYSQL_SECONDARY_CHARSET=utf8mb4
MYSQL_SECONDARY_TIMEZONE=Local

# Connection Pool Settings
MYSQL_SECONDARY_MAX_IDLE_CONNS=10
MYSQL_SECONDARY_MAX_OPEN_CONNS=200
MYSQL_SECONDARY_CONN_MAX_LIFETIME=15m
MYSQL_SECONDARY_CONN_MAX_IDLE_TIME=5m

# ============================================
# MongoDB Configuration (Optional)
# ============================================
# Uncomment if using MongoDB
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB=golang_starter_kit_2025
# MONGO_USER=root
# MONGO_PASS=your_mongo_password
# MONGO_COLL="${APP_ENV}"

# ============================================
# Other Configuration
# ============================================
IMAGE_EXPIRE_MINUTES=2
DB_FORWARDER_PORT=3307
