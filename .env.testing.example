# ============================================
# Testing Environment Configuration
# ============================================
# This file is used for integration and e2e tests
# Similar to Laravel's .env.testing
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.testing
#    cp .env.testing.example .env.testing
# 2. Update the credentials below with your local test database credentials
# 3. Run: ./tests/setup_test_db.sh to create test database

APP_NAME="Golang Starter Kit 2025 - Testing"
APP_ENV=testing
APP_SCHEME=http
APP_HOST=localhost
APP_PORT=9998
APP_VERSION=1.0.0

# Logging Configuration (more verbose for testing)
LOG_LEVEL=debug

# ============================================
# Security Configuration (Testing)
# ============================================
JWT_SECRET_KEY=test_secret_key_for_integration_testing_only_32_chars_minimum
JWT_EXPIRE_MINUTES=60

# SKIP_AUTH should be false in tests to test authentication
SKIP_AUTH=false

# Rate Limiting (more permissive for tests)
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_AUTH=100
RATE_LIMIT_AUTH_PERIOD_MINUTES=15
RATE_LIMIT_USER=10000
RATE_LIMIT_USER_PERIOD_MINUTES=60

# ============================================
# Test Database Configuration (MySQL)
# ============================================
# IMPORTANT: This database will be dropped and recreated for each test
DB_CONNECTION=mysql

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=golang_starter_kit_2025_test
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEZONE=Local

# Smaller pool for testing
MYSQL_MAX_IDLE_CONNS=5
MYSQL_MAX_OPEN_CONNS=10
MYSQL_CONN_MAX_LIFETIME=5m
MYSQL_CONN_MAX_IDLE_TIME=2m

# ============================================
# PostgreSQL Test Database (Optional)
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=golang_starter_kit_2025_test_pg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC

POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=5m
POSTGRES_CONN_MAX_IDLE_TIME=2m

# ============================================
# Redis Configuration (Testing)
# ============================================
# Use separate Redis DB for testing
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_PORT=6379

# ============================================
# Performance Configuration (Testing)
# ============================================
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_MINUTES=1
IMAGE_EXPIRE_MINUTES=2
